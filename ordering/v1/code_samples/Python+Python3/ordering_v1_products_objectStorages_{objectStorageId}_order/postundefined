import http.client

conn = http.client.HTTPSConnection("api.leaseweb.com")

payload = "{\"location\":\"AMS-01\",\"storageQuantity\":1000,\"contractTerm\":\"1_YEAR\",\"dryRun\":true}"

headers = {
    'X-LSW-Auth': "REPLACE_KEY_VALUE",
    'content-type': "application/json"
    }

conn.request("POST", "/ordering/v1/products/objectStorages/reserved/order", payload, headers)

res = conn.getresponse()
data = res.read()

print(data.decode("utf-8"))