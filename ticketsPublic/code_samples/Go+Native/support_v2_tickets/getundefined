package main

import (
	"fmt"
	"net/http"
	"io/ioutil"
)

func main() {

	url := "https://api.leaseweb.com/support/v2/tickets?limit=20&offset=10&subject=test&status=NEW%2CIN_PROGRESS&createdBy=johndoe%40gmail.com&creationDateFrom=2025-01-01T00%3A00%3A00Z&creationDateTo=2025-12-31T00%3A00%3A00Z&lastUpdateDateFrom=2025-01-01T00%3A00%3A00Z&lastUpdateDateTo=2025-12-31T00%3A00%3A00Z&sortBy=createdAt&sortDirection=DESC"

	req, _ := http.NewRequest("GET", url, nil)

	req.Header.Add("X-LSW-Auth", "REPLACE_KEY_VALUE")

	res, _ := http.DefaultClient.Do(req)

	defer res.Body.Close()
	body, _ := ioutil.ReadAll(res.Body)

	fmt.Println(res)
	fmt.Println(string(body))

}