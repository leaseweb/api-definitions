package main

import (
	"fmt"
	"strings"
	"net/http"
	"io/ioutil"
)

func main() {

	url := "https://api.leaseweb.com/support/v2/tickets"

	payload := strings.NewReader("{\"attachments\":[{\"content\":\"VGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIGEgbGF6eSBkb2c=\",\"mimeType\":\"text/plain\",\"name\":\"attachment.txt\"}],\"body\":\"Hi, hello this is my problem\",\"equipments\":[{\"equipmentId\":\"string\"}],\"subject\":\"Hello world\",\"email\":\"johndoe@example.com\"}")

	req, _ := http.NewRequest("POST", url, payload)

	req.Header.Add("X-LSW-Auth", "REPLACE_KEY_VALUE")
	req.Header.Add("content-type", "application/json")

	res, _ := http.DefaultClient.Do(req)

	defer res.Body.Close()
	body, _ := ioutil.ReadAll(res.Body)

	fmt.Println(res)
	fmt.Println(string(body))

}